{
  "name": "whisper-bot",
  "version": "1.0.0",
  "description": "A premium inline Telegram Whisper Bot built with grammY, running on Cloudflare Workers with KV storage.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "webhook:set": "node scripts/set-webhook.mjs",
    "webhook:delete": "node scripts/delete-webhook.mjs"
  },
  "dependencies": {
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
